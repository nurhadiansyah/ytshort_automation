# 1. AI Scriptwriter (Pilih salah satu: Gemini atau OpenAI)
GEMINI_API_KEY=your_gemini_api_key_here
# OPENAI_API_KEY=

# 2. Voiceover (ElevenLabs)
ELEVENLABS_API_KEY= 
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM   # Contoh default voice ID (Rachel / sesuaikan dengan pilihan Anda)

# 3. AI Image Generator Cadangan (Opsional - Hugging Face FLUX.1-schnell Gratis)
# Dapatkan token gratis di: https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=

# 4. YouTube Upload
# Letakkan file OAuth2 dari Google Cloud Console dengan nama: client_secret.json di root folder ini.
YOUTUBE_CLIENT_SECRET_FILE=client_secret.json
